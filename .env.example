# Copy to .env.local for a local web preview. Use the Supabase Project URL and
# publishable/anon key; never put a service_role key in a frontend app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Leave this unset for local development. The Pages workflow sets it for builds.
# VITE_BASE_PATH=/your-github-repository/
